# Deva Bio Engineering website — build configuration
# Author: Justonclick Team (https://justonclick.in) · Copyright (c) Justonclick. All rights reserved.
#
# Public domain of the website (no trailing slash). Used for canonical URLs, Open Graph,
# structured data, sitemap.xml and robots.txt. PLACEHOLDER — confirm the company's domain.
REACT_APP_SITE_URL=https://devabioengineering.in

# Optional Google Tag Manager container, e.g. GTM-XXXXXXX. Leave empty to disable.
REACT_APP_GTM_ID=

# Enquiry form endpoint (JSON POST). Examples:
#   Web3Forms:  https://api.web3forms.com/submit   (+ REACT_APP_ENQUIRY_ACCESS_KEY)
#   Formspree:  https://formspree.io/f/<form-id>
#   Google Apps Script web app URL, or your own API.
# Leave empty to fall back to a pre-filled email (mailto) to the company address.
REACT_APP_ENQUIRY_ENDPOINT=
REACT_APP_ENQUIRY_ACCESS_KEY=
